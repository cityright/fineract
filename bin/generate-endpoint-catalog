#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/fineract/openapi_endpoint_generator"

ROOT = File.expand_path("..", __dir__)
options = {
  specification: File.join(ROOT, "specifications/fineract-1.15.0.json"),
  overrides: File.join(ROOT, "specifications/operation_id_overrides.yml"),
  output: File.join(ROOT, "lib/fineract/generated/endpoint_definitions.rb")
}
OptionParser.new do |parser|
  parser.on("--specification PATH") { |value| options[:specification] = value }
  parser.on("--overrides PATH") { |value| options[:overrides] = value }
  parser.on("--output PATH") { |value| options[:output] = value }
  parser.on("--check") { options[:check] = true }
end.parse!

document = JSON.parse(File.read(options[:specification]))
overrides = Fineract::OpenapiEndpointGenerator.load_overrides(options[:overrides])
operations = Fineract::OpenapiEndpointGenerator.new(document: document, overrides: overrides).operations
json = JSON.pretty_generate(operations)
# rubocop:disable Layout/HeredocIndentation
rendered = <<~RUBY
  # frozen_string_literal: true

  # This file is generated by bin/generate-endpoint-catalog. Do not edit it.
  require "json"

  module Fineract
    module GeneratedEndpointDefinitions
      RAW = JSON.parse(<<'JSON')
#{json}
JSON
      def self.deep_freeze(value)
        case value
        when Hash then value.each { |key, item| deep_freeze(key); deep_freeze(item) }
        when Array then value.each { |item| deep_freeze(item) }
        end
        value.freeze
      end
      private_class_method :deep_freeze
      deep_freeze(RAW)
      OPERATION_NAMES = RAW.map { |operation| operation.fetch("operation") }.freeze
    end
  end
RUBY
# rubocop:enable Layout/HeredocIndentation

if options[:check]
  abort "generated endpoint definitions are stale; run bin/generate-endpoint-catalog" unless File.file?(options[:output]) && File.read(options[:output]) == rendered
  puts "Endpoint definitions are current (#{operations.length} operations)"
else
  Dir.mkdir(File.dirname(options[:output])) unless Dir.exist?(File.dirname(options[:output]))
  File.write(options[:output], rendered)
  puts "Generated #{options[:output]} (#{operations.length} operations)"
end
