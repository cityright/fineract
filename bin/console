#!/usr/bin/env ruby
# frozen_string_literal: true

require "fineract"

Fineract.configure do |config|
  config.base_url = ENV.fetch("FINERACT_BASE_URL")
  config.tenant_id = ENV.fetch("FINERACT_TENANT_ID", "default")
  config.username = ENV["FINERACT_USERNAME"]
  config.password = ENV["FINERACT_PASSWORD"]
end

require "irb"
IRB.start
