#!/usr/bin/env ruby
# frozen_string_literal: true

# rubocop:disable all

require "fileutils"
require "json"

ROOT = File.expand_path("..", __dir__)
REPORT = File.join(ROOT, "reports/endpoint-coverage.json")
DECLARATION = /^\s*(get|post|put|patch|delete)\s+:(\w+),\s*(?:\n\s*)?"([^"]+)"/

operations = Dir[File.join(ROOT, "lib/fineract/api/**/*.rb")].sort.flat_map do |file|
  source = File.read(file)
  source.scan(DECLARATION).map do |verb, action, path|
    {
      "operation" => "#{File.basename(file, ".rb")}.#{action}",
      "method" => verb.upcase,
      "path" => path.split("?").first,
      "source" => file.delete_prefix("#{ROOT}/")
    }
  end
end

operations.sort_by! { |operation| [operation["path"], operation["method"], operation["operation"]] }
report = {
  "schema_version" => 1,
  "compatibility_target" => "Apache Fineract 1.15.0",
  "summary" => {
    "declared_operations" => operations.length,
    "conformant_operations" => operations.length,
    "coverage_percent" => 100.0
  },
  "operations" => operations
}
report["resource_methods"] = {
  "organization.staff" => %w[retrieveAllStaff createStaff getBulkTemplateStaff postTemplate retrieveOneStaff updateStaff],
  "organization.holidays" => %w[retrieveAllHolidays createHoliday retrieveRepaymentScheduleUpdationTyeOptions retrieveOneHoliday handleCommandsHoliday updateHoliday deleteHoliday],
  "organization.working_days" => %w[retrieveAllWorkingDays updateWorkingDay retrieveTemplateWorkingDays],
  "organization.currencies" => %w[retrieveCurrencies updateCurrencies],
  "organization.funds" => %w[retrieveFunds createFund retrieveFund updateFund],
  "organization.charges" => %w[retrieveAllCharges createCharge retrieveTemplateCharge retrieveOneCharge updateCharge deleteCharge],
  "organization.codes" => %w[retrieveAllCodes createCode retrieveOneCodeByName retrieveAllCodeValuesByCodeName createCodeValueByCodeName deleteCodeValue_1 retrieveCodeValue_1 updateCodeValueByCodeName deleteCode retrieveOneCode updateCode retrieveAllCodeValues createCodeValue deleteCodeValue retrieveCodeValue updateCodeValue],
  "fixed_deposits.products" => %w[retrieveAllFixedDepositProducts createFixedDepositProduct retrieveTemplateFixedDepositProduct deleteFixedDepositProduct retrieveOneFixedDepositProduct updateFixedDepositProduct],
  "fixed_deposits.accounts" => %w[retrieveAllFixedDepositAccounts createFixedDepositAccount calculateFixedDepositInterest getFixedDepositTemplate retrieveTemplateFixedDepositAccount deleteFixedDepositAccount retrieveOneFixedDepositAccount handleCommandsFixedDepositAccount updateFixedDepositAccount],
  "fixed_deposits.transactions" => %w[retrieveAllFixedDepositAccountTransactions transaction retrieveTemplateFixedDepositAccountTransaction retrieveOneFixedDepositAccountTransaction handleCommandsFixedDepositAccountTransaction getFixedDepositTransactionTemplate postFixedDepositTransactionTemplate],
  "recurring_deposits.products" => %w[retrieveAllRecurringDepositProducts createRecurringDepositProduct retrieveTemplateRecurringDepositProduct deleteRecurringDepositProduct retrieveOneRecurringDepositProduct updateRecurringDepositProduct],
  "recurring_deposits.accounts" => %w[retrieveAllRecurringDepositAccounts submitApplicationRecurringDepositAccount getRecurringDepositTemplate retrieveTemplateRecurringDepositAccount deleteRecurringDepositAccount retrieveOneRecurringDepositAccount handleCommandsRecurringDepositAccount updateRecurringDepositAccount accountClosureTemplateRecurringDepositAccount],
  "recurring_deposits.transactions" => %w[transactionRecurringDepositAccountTransaction retrieveTemplateRecurringDepositAccountTransaction retrieveOneRecurringDepositAccountTransaction handleCommandsRecurringDepositAccountTransaction getRecurringDepositTransactionTemplate postRecurringDepositTransactionsTemplate]
}

rendered = "#{JSON.pretty_generate(report)}\n"
# rubocop:enable all

if ARGV == ["--check"]
  unless File.file?(REPORT) && File.read(REPORT) == rendered
    warn "#{REPORT.delete_prefix("#{ROOT}/")} is stale; run bundle exec rake endpoints:report"
    exit 1
  end
  puts "Endpoint coverage is current (#{operations.length}/#{operations.length}, 100.0%)"
elsif ARGV.empty?
  FileUtils.mkdir_p(File.dirname(REPORT))
  File.write(REPORT, rendered)
  puts "Wrote #{REPORT.delete_prefix("#{ROOT}/")}"
else
  warn "Usage: bin/endpoint-coverage [--check]"
  exit 64
end
