# Opt in only for a dedicated Apache Fineract 1.15.0 test deployment.
FINERACT_INTEGRATION=1
FINERACT_VERSION=1.15.0
FINERACT_BASE_URL=https://fineract.test.example/fineract-provider/api
FINERACT_TENANT_ID=isolated-test
FINERACT_USERNAME=
FINERACT_PASSWORD=

# Destructive tests additionally require both flags and reject shared demo hosts.
FINERACT_DESTRUCTIVE=0
FINERACT_DEDICATED=1
